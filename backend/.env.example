# Database (PostgreSQL; use separate pooled/direct URLs when your provider requires it)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# JWT
JWT_SECRET="dev-secret-key-minimum-32-characters-long-for-development"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Finik Web SDK (start with beta; never commit real credentials or RSA keys)
FINIK_MODE=beta
FINIK_API_KEY=
FINIK_ACCOUNT_ID=
# Keep the PEM on one line. The backend converts literal \n sequences to newlines.
FINIK_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----"
# Optional override for Finik's webhook verification key; the official beta/prod keys are built in.
FINIK_PUBLIC_KEY=
# Must be an absolute public HTTPS URL and must match the registered callback exactly.
FINIK_WEBHOOK_URL=https://api.example.com/api/billing/finik/webhook
FINIK_MERCHANT_NAME=OimoQR
FINIK_PAYMENT_TTL_MINUTES=30
FINIK_SETTLEMENT_GRACE_MINUTES=1440
FINIK_WEBHOOK_TOLERANCE_SECONDS=300
FINIK_REQUEST_TIMEOUT_MS=10000

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Trial Period (days)
TRIAL_PERIOD_DAYS=7
