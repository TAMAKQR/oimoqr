generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  name              String
  phone             String?
  isAdmin           Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  restaurants       Restaurant[]
  restaurantStaff   RestaurantStaff[]
  subscriptions     Subscription[]
}

model Restaurant {
  id                String    @id @default(cuid())
  subdomain         String    @unique
  name              String
  description       String?
  phone             String?
  address           String?
  city              String?
  country           String?
  currency          String    @default("RUB")
  banners           String?
  logo              String?
  cardStyle         String    @default("grid")
  isTrialDefault    Boolean   @default(false)
  deliveryEnabled   Boolean   @default(false)
  deliveryFee       Float?
  minOrderAmount    Float?
  defaultLanguage   String    @default("ru")
  
  // Business type
  businessType      String    @default("RESTAURANT") // RESTAURANT | ONLINE_STORE
  
  // Geolocation fields
  latitude          Float?
  longitude         Float?
  deliveryRadius    Float?    // Радиус доставки в км
  
  // Working hours fields
  workingHours      String?   // JSON: {"monday": {"open": "09:00", "close": "22:00", "isOpen": true}, ...}
  isTemporarilyClosed Boolean @default(false)
  closureReason     String?
  
  // Telegram notifications
  telegramGroupId   String?   // ID группы Telegram для уведомлений
  telegramBotToken  String?   // Опциональный кастомный бот токен
  
  ownerId           String
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  categories        Category[]
  dishes            Dish[]
  staff             RestaurantStaff[]
  socialLinks       SocialLink?
  orders            Order[]
  languages         RestaurantLanguage[]
  dishTranslations  DishTranslation[]
  categoryTranslations CategoryTranslation[]
  
  // Category Groups (мета-категории)
  categoryGroups    CategoryGroup[]
  
  // Modifier Templates (шаблоны модификаторов)
  modifierTemplates ModifierTemplate[]
  
  // Online Store relations
  productCategories ProductCategory[]
  products          Product[]

  // Customers who registered from this restaurant
  registeredCustomers Customer[] @relation("CustomerRegisteredRestaurant")
  
  subscriptions     Subscription[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model RestaurantStaff {
  id                String    @id @default(cuid())
  userId            String
  restaurantId      String
  role              String    @default("staff")
  
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@unique([userId, restaurantId])
}

model Subscription {
  id                String    @id @default(cuid())
  
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  
  plan              String    @default("TRIAL")
  status            String    @default("TRIAL")
  
  trialEndsAt       DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd  DateTime?
  
  pricingTierId     String?
  pricingTier       PricingTier? @relation(fields: [pricingTierId], references: [id], onDelete: SetNull)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Группы категорий (мета-категории)
model CategoryGroup {
  id                String    @id @default(cuid())
  name              String
  description       String?
  image             String?   // Фото-миниатюра
  order             Int       @default(0)
  
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  categories        Category[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([restaurantId])
}

model Category {
  id                String    @id @default(cuid())
  name              String
  description       String?
  image             String?
  order             Int       @default(0)
  
  // Привязка к группе категорий (опционально)
  categoryGroupId   String?
  categoryGroup     CategoryGroup? @relation(fields: [categoryGroupId], references: [id], onDelete: SetNull)
  
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  dishes            Dish[]
  translations      CategoryTranslation[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Dish {
  id                String    @id @default(cuid())
  name              String
  description       String?
  price             Float
  image             String?
  available         Boolean   @default(true)
  order             Int       @default(0)
  allergens         String?
  discount          Int?
  badge             String?
  
  // Recommendations (manual cross-selling)
  recommendationIds String[]  @default([])
  
  categoryId        String
  category          Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  modifiers         Modifier[]
  orderItems        OrderItem[]
  translations      DishTranslation[]
  favoritedBy       CustomerFavorite[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Modifier {
  id                String    @id @default(cuid())
  name              String
  type              String
  price             Float?    @default(0)
  isRequired        Boolean   @default(false)
  order             Int       @default(0)
  
  dishId            String
  dish              Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  
  // Связь с шаблоном (если модификатор создан из шаблона)
  templateId        String?
  template          ModifierTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  
  options           ModifierOption[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([templateId])
}

model ModifierOption {
  id                String    @id @default(cuid())
  name              String
  price             Float     @default(0)
  image             String?   // ✅ Фото для конкретного модификатора (например, коктейль с клубникой)
  
  modifierId        String
  modifier          Modifier  @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ========================================
// Шаблоны модификаторов (библиотека ресторана)
// ========================================

model ModifierTemplate {
  id                String    @id @default(cuid())
  name              String
  type              String    // single | multi
  isRequired        Boolean   @default(false)
  
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  options           ModifierTemplateOption[]
  usedInModifiers   Modifier[] // Модификаторы, созданные из этого шаблона
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([restaurantId])
}

model ModifierTemplateOption {
  id                String    @id @default(cuid())
  name              String
  price             Float     @default(0)
  image             String?
  
  templateId        String
  template          ModifierTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([templateId])
}

model SocialLink {
  id                String    @id @default(cuid())
  instagram         String?
  facebook          String?
  telegram          String?
  whatsapp          String?
  
  restaurantId      String    @unique
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Customer {
  id                String    @id @default(cuid())
  phone             String    @unique // Уникальный номер телефона глобально
  name              String?
  email             String?
  password          String    // Обязательный пароль
  avatar            String?   // URL аватара
  
  // Preferences (JSON: {vegetarian, allergies, spicyLevel, etc.})
  preferences       String?   

  // Restaurant where customer registered (optional)
  registeredRestaurantId String?
  registeredRestaurant   Restaurant? @relation("CustomerRegisteredRestaurant", fields: [registeredRestaurantId], references: [id])
  
  // Saved addresses
  savedAddresses    CustomerAddress[]
  orders            Order[]
  favoriteDishes    CustomerFavorite[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model CustomerFavorite {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  dishId            String
  dish              Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime  @default(now())
  
  @@unique([customerId, dishId])
  @@index([customerId])
}

model CustomerAddress {
  id                String    @id @default(cuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  address           String
  entrance          String?
  floor             String?
  apartment         String?
  latitude          Float?
  longitude         Float?
  label             String?   // "Дом", "Работа", etc.
  comment           String?
  isDefault         Boolean   @default(false)
  orders            Order[]   @relation("OrderCustomerAddress")
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Order {
  id                String    @id @default(cuid())
  orderNumber       String    @unique
  customerName      String
  customerPhone     String
  customerEmail     String?
  deliveryAddress   String?
  deliveryLatitude  Float?
  deliveryLongitude Float?
  totalAmount       Float
  status            String    @default("new")
  notes             String?
  deliveryType      String    @default("delivery")
  paymentMethod     String    @default("cash")
  customerAddressId String?
  customerAddress   CustomerAddress? @relation("OrderCustomerAddress", fields: [customerAddressId], references: [id], onDelete: SetNull)
  
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  assignedRestaurantId String?  // ID ресторана/точки, которой переназначен заказ
  
  items             OrderItem[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model OrderItem {
  id                String    @id @default(cuid())
  quantity          Int
  price            Float
  selectedModifiers Json?
  
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // For restaurant orders
  dishId            String?
  dish              Dish?     @relation(fields: [dishId], references: [id], onDelete: SetNull)
  
  // For online store orders
  productId         String?
  product           Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model PricingTier {
  id                String    @id @default(cuid())
  name              String
  price             Float
  description       String?
  features          String?
  maxRestaurants    Int?
  order             Int       @default(0)
  isActive          Boolean   @default(true)
  
  subscriptions     Subscription[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model RestaurantLanguage {
  id                String    @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  languageCode      String
  isEnabled         Boolean   @default(true)
  order             Int       @default(0)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@unique([restaurantId, languageCode])
}

model DishTranslation {
  id                String    @id @default(cuid())
  dishId            String
  dish              Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  languageCode      String
  
  name              String
  description       String?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@unique([dishId, languageCode])
  @@index([restaurantId])
}

model CategoryTranslation {
  id                String    @id @default(cuid())
  categoryId        String
  category          Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  languageCode      String
  
  name              String
  description       String?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@unique([categoryId, languageCode])
  @@index([restaurantId])
}

model TrialConfig {
  id                String    @id @default(cuid())
  name              String    @default("Пробный период")
  days              Int       @default(7)
  message           String    @default("Вы получите 7 дней бесплатного пробного периода")
  
  updatedAt         DateTime  @updatedAt
}

// ========================================
// Online Store Models
// ========================================

model ProductCategory {
  id                String    @id @default(cuid())
  name              String
  description       String?
  image             String?
  order             Int       @default(0)
  isActive          Boolean   @default(true)
  
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  products          Product[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Product {
  id                String    @id @default(cuid())
  name              String
  description       String?
  sku               String?   // SKU/Артикул
  price             Float
  compareAtPrice    Float?    // Цена для сравнения (было)
  cost              Float?    // Себестоимость
  images            String?   // JSON массив изображений
  available         Boolean   @default(true)
  featured          Boolean   @default(false) // Рекомендуемый товар
  order             Int       @default(0)
  
  // SEO
  metaTitle         String?
  metaDescription   String?
  
  // Stock
  trackInventory    Boolean   @default(true)
  stockQuantity     Int       @default(0)
  lowStockThreshold Int?
  
  // Attributes
  weight            Float?    // Вес в граммах
  dimensions        String?   // JSON: {length, width, height}
  
  categoryId        String
  category          ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  variants          ProductVariant[]
  orderItems        OrderItem[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([restaurantId, available])
  @@index([categoryId])
}

model ProductVariant {
  id                String    @id @default(cuid())
  name              String    // Например: "Размер: L, Цвет: Красный"
  sku               String?
  price             Float?    // Цена варианта (если отличается от базовой)
  compareAtPrice    Float?
  stockQuantity     Int       @default(0)
  image             String?
  
  // Опции варианта (размер, цвет и т.д.)
  options           String    // JSON: {"size": "L", "color": "Red"}
  
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([productId])
}

model MenuView {
  id                String    @id @default(cuid())
  restaurantId      String
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  
  @@index([restaurantId, createdAt])
}
